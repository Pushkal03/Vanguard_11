{
  "entities": {
    "StudentWorkspace": {
      "title": "StudentWorkspace",
      "description": "Synchronized student workspace state across up to 5 devices and up to 2 linked parent accounts.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the student owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Display name of the student.",
          "minLength": 1,
          "maxLength": 80
        },
        "classStandard": {
          "type": "string",
          "description": "Academic class or grade standard of the student.",
          "enum": [
            "10th Standard",
            "11th Standard",
            "12th Standard",
            "Dropper / Gap Year"
          ],
          "minLength": 1,
          "maxLength": 50
        },
        "targetExam": {
          "type": "string",
          "description": "Primary target competitive or board examination.",
          "enum": [
            "JEE Main & Advanced",
            "NEET UG",
            "BITSAT & Olympiads",
            "Computer Science & SAT",
            "Board Exams Excellence"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "pairingCode": {
          "type": "string",
          "description": "Invite code used to link up to 2 parent accounts and up to 5 student devices.",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentIds": {
          "type": "array",
          "description": "Bounded list of up to 2 linked parent account UIDs.",
          "maxLength": 2
        },
        "deviceIds": {
          "type": "array",
          "description": "Bounded list of up to 5 registered student device IDs.",
          "maxLength": 5
        },
        "deviceNames": {
          "type": "array",
          "description": "Bounded list of up to 5 registered student device labels.",
          "maxLength": 5
        },
        "isLockdownActive": {
          "type": "boolean",
          "description": "Whether Full-Device Lockdown Mode is currently active across all 5 student devices."
        },
        "cameraVerified": {
          "type": "boolean",
          "description": "Whether the 5s webcam presence monitor currently verifies the student at their desk."
        },
        "cameraConfidence": {
          "type": "number",
          "description": "Latest webcam presence confidence percentage (0 to 100)."
        },
        "xpPoints": {
          "type": "number",
          "description": "Earned discipline XP points."
        },
        "streakDays": {
          "type": "number",
          "description": "Active daily discipline streak."
        },
        "activeBlockTitle": {
          "type": "string",
          "description": "Title of the currently active timetable slot.",
          "minLength": 1,
          "maxLength": 160
        },
        "activeBlockCategory": {
          "type": "string",
          "description": "Category of the currently active timetable slot.",
          "enum": ["study", "coding", "break", "revision"],
          "minLength": 1,
          "maxLength": 40
        },
        "completedTasksCount": {
          "type": "number",
          "description": "Number of completed daily tasks."
        },
        "totalTasksCount": {
          "type": "number",
          "description": "Total number of daily tasks."
        },
        "violationsCount": {
          "type": "number",
          "description": "Total focus or lockdown violations recorded today."
        },
        "latestFileTitle": {
          "type": "string",
          "description": "Name of the most recently uploaded PDF or homework file.",
          "minLength": 1,
          "maxLength": 160
        },
        "latestFileSubject": {
          "type": "string",
          "description": "Subject tag of the most recently uploaded file.",
          "minLength": 1,
          "maxLength": 80
        },
        "latestFileContent": {
          "type": "string",
          "description": "Extracted text content of the most recently uploaded PDF or study file synced across devices.",
          "minLength": 1,
          "maxLength": 8000
        },
        "latestMomentText": {
          "type": "string",
          "description": "Summary of the most recent student study moment for parent live display.",
          "minLength": 1,
          "maxLength": 300
        },
        "parentEncouragement": {
          "type": "string",
          "description": "Latest live message or nudge sent from a linked parent account.",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "studentName",
        "classStandard",
        "targetExam",
        "pairingCode",
        "parentIds",
        "deviceIds",
        "deviceNames",
        "isLockdownActive",
        "cameraVerified",
        "cameraConfidence",
        "xpPoints",
        "streakDays",
        "activeBlockTitle",
        "activeBlockCategory",
        "completedTasksCount",
        "totalTasksCount",
        "violationsCount",
        "latestFileTitle",
        "latestFileSubject",
        "latestFileContent",
        "latestMomentText",
        "parentEncouragement",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentMoment": {
      "title": "StudentMoment",
      "description": "Granular real-time activity event recorded for parent accounts and cross-device audit.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Parent workspace ID (student UID).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "description": "UID of the user (student or linked parent) who generated this event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventType": {
          "type": "string",
          "description": "Category of the real-time moment.",
          "enum": [
            "lockdown",
            "camera",
            "file_upload",
            "task_complete",
            "violation",
            "device_sync",
            "parent_note"
          ],
          "minLength": 1,
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "description": "Human-readable description of the moment.",
          "minLength": 1,
          "maxLength": 300
        },
        "deviceLabel": {
          "type": "string",
          "description": "Label of the device where the moment occurred.",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "workspaceId",
        "authorId",
        "eventType",
        "summary",
        "deviceLabel",
        "createdAt"
      ]
    },
    "SyncedStudyFile": {
      "title": "SyncedStudyFile",
      "description": "Uploaded PDF or homework file synchronized across all 5 student devices.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Parent workspace ID (student UID).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Student owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Document file name.",
          "minLength": 1,
          "maxLength": 160
        },
        "subject": {
          "type": "string",
          "description": "Academic subject tag.",
          "minLength": 1,
          "maxLength": 80
        },
        "sizeLabel": {
          "type": "string",
          "description": "Formatted file size label.",
          "minLength": 1,
          "maxLength": 40
        },
        "contentPreview": {
          "type": "string",
          "description": "Extracted text content of the PDF or worksheet.",
          "minLength": 1,
          "maxLength": 9000
        },
        "notes": {
          "type": "string",
          "description": "Student scratchpad notes for this file.",
          "minLength": 0,
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "workspaceId",
        "ownerId",
        "name",
        "subject",
        "sizeLabel",
        "contentPreview",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/StudentWorkspace"
      },
      "description": "Primary student workspace state synced across up to 5 devices and 2 linked parent accounts."
    },
    "/workspaces/{workspaceId}/moments/{momentId}": {
      "schema": {
        "$ref": "#/entities/StudentMoment"
      },
      "description": "Chronological real-time activity feed of every student update and moment."
    },
    "/workspaces/{workspaceId}/files/{fileId}": {
      "schema": {
        "$ref": "#/entities/SyncedStudyFile"
      },
      "description": "PDF and homework files synchronized across all 5 student devices."
    }
  }
}
